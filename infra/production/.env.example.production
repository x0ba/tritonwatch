IMAGE_TAG=latest

CLERK_ISSUER=https://clerk.tritonwatch.app
CLERK_AUTHORIZED_PARTIES=https://tritonwatch.app
CORS_ALLOWED_ORIGINS=https://tritonwatch.app,http://localhost:5173

# Generate each independently with: openssl rand -base64 32
POSTGRES_ADMIN_PASSWORD=replace-me
USER_DATABASE_PASSWORD=replace-me
WATCHLIST_DATABASE_PASSWORD=replace-me
INGESTION_DATABASE_PASSWORD=replace-me
NOTIFICATION_DATABASE_PASSWORD=replace-me

INGESTION_POLL_INTERVAL=2m
UCSD_API_BASE_URL=https://classplanner.apps.ucsd.edu

KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_RETENTION_MS=604800000
KAFKA_LOG_RETENTION_HOURS=168
