aws_region        = "us-west-2"
availability_zone = "us-west-2a"

project_name  = "tritonwatch"
environment   = "production"
instance_type = "t3a.medium"

# Keep false for the first apply. Push images, then change it to true.
deploy_application = false
image_tag          = "latest"

domain_name = "tritonwatch.app"

clerk_issuer             = "https://clerk.tritonwatch.app"
clerk_authorized_parties = "https://tritonwatch.app"
cors_allowed_origins     = "https://tritonwatch.app,http://localhost:5173"

# Required for the apex hostname (ACM + Route 53 alias to CloudFront).
# Without it, the app is still available on the CloudFront default domain.
route53_zone_id = null

budget_email       = "admin@tritonwatch.app"
monthly_budget_usd = 50

enable_backups        = true
backup_retention_days = 7

github_repository           = "x0ba/tritonwatch"
github_owner_id             = "64868985"
github_repository_id        = "1346732326"
github_deploy_environment   = "production"
create_github_oidc_provider = true
