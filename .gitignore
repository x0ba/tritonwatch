.DS_Store

# Local process logs from scripts/dev.sh
.dev-logs/

# Runtime secrets
**/*.env
**/*.env.*
!**/*.env.example
!**/*.env.example.*
!**/*.env.production.example
mise.local.toml
mise.local.lock

# Java and Gradle
.gradle/
**/build/
.buildx-cache/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
*.auto.tfvars
*.auto.tfvars.json
crash.log
crash.*.log
